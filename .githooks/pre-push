#!/bin/sh
set -eu

remote_name="$1"
zero_oid="0000000000000000000000000000000000000000"

node scripts/check-privacy.mjs --check-config --check-identity

while read -r local_ref local_oid remote_ref remote_oid; do
  if [ "$local_oid" = "$zero_oid" ]; then
    continue
  fi

  node scripts/check-privacy.mjs --check-ref-name "$local_ref"

  case "$local_ref" in
    refs/tags/*)
      node scripts/check-privacy.mjs --check-tag "$local_ref"
      ;;
    *)
      if [ "$remote_oid" = "$zero_oid" ]; then
        for commit in $(git rev-list "$local_oid" --not --remotes="$remote_name"); do
          node scripts/check-privacy.mjs --check-commit "$commit"
        done
      else
        node scripts/check-privacy.mjs --check-range "$remote_oid" "$local_oid"
      fi
      ;;
  esac
done
